rules_version = '2';
// Biblioteca Mário Rubens: só os quatro logins autorizados leem e gravam.
service cloud.firestore {
  match /databases/{database}/documents {
    function autorizado() {
      return request.auth != null
        && request.auth.token.email in [
          'marubens@biblioteca.mariorubens.app',
          'mariley@biblioteca.mariorubens.app',
          'marina@biblioteca.mariorubens.app',
          'marcus@biblioteca.mariorubens.app'
        ];
    }
    match /{document=**} {
      allow read, write: if autorizado();
    }
  }
}
